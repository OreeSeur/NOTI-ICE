# PLANTILLA: no habilitar antes de crear usuario, directorios y archivo privado.
# Instalar como /etc/systemd/system/noti-ice-api.service solo tras revisar rutas.
[Unit]
Description=NOTI ICE ASP.NET Core 8 API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=notiice
Group=notiice
WorkingDirectory=/opt/noti-ice/backend
EnvironmentFile=/etc/noti-ice/api.env
ExecStart=/usr/bin/dotnet /opt/noti-ice/backend/NoiceBack.dll
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Crear antes el directorio persistente con propietario notiice y modo 0700.
# El binario permanece de solo lectura; los adjuntos sobreviven a las publicaciones.
ReadWritePaths=/var/lib/noti-ice/uploads

[Install]
WantedBy=multi-user.target
