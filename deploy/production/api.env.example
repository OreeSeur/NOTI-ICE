# EJEMPLO SIN SECRETOS. NO usar un dominio de ejemplo para desplegar.
# Copiar fuera del repositorio a /etc/noti-ice/api.env (solo administracion, permisos 0600).
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5135
AllowedHosts=notiice.example.org

# Para frontend y API en el MISMO origen, se puede omitir Cors__AllowedOrigins__0.
# Para frontend alojado en un dominio distinto, proporcionar su origen HTTPS exacto.
Cors__AllowedOrigins__0=https://notiice.example.org

# Nginx instalado en el mismo servidor; localhost ya es confiable por defecto.
# ReverseProxy__KnownProxies__0=192.0.2.10

Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__Model=llama3.2:3b
Chatbot__Limits__RequestsPerWindow=5
Chatbot__Limits__WindowSeconds=60
Chatbot__Limits__MaxConcurrentGenerations=1
Chatbot__Limits__BusyRetryAfterSeconds=5

# Definir PRIVADAMENTE en /etc/noti-ice/api.env las claves que correspondan:
# ConnectionStrings__PortalNoticiasDb  (apuntar solo al esquema autorizado de produccion)
# Jwt__Key, Jwt__Issuer, Jwt__Audience
# Email__... (solo si se habilita el servicio SMTP)
# No escribir claves ni contrasenas reales en este archivo versionado.
